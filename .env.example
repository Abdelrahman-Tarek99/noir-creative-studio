# NOIR Contact Form — Email Provider Configuration
#
# The contact form works without these variables (submissions are logged
# to the server console). To deliver emails, configure a provider:
#
# Resend (https://resend.com):
#   CONTACT_PROVIDER_URL=https://api.resend.com/emails
#   CONTACT_PROVIDER_KEY=re_xxxxxxxxxxxxx
#   CONTACT_EMAIL=your-real-email@example.com
#
# Other providers: any API that accepts a POST with JSON body
# { from, to, subject, replyTo, text } and a Bearer auth header.

CONTACT_PROVIDER_URL=
CONTACT_PROVIDER_KEY=
CONTACT_EMAIL=
